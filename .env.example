# Copy this file to your deployment secret store. Do NOT commit real secrets.
GEMINI_API_KEY=
SCOUT_API_KEY=
ADMIN_PASSWORD=
REDIS_URL=
SCOUT_STORAGE_MODE=auto
PAYMENT_PROVIDER_MODE=stripe
SCOUT_POLICY_FILE=fraud_policy.json
ENVIRONMENT=development

# Production payment provider integration should set its own credentials here,
# using the provider's official secret-management mechanism.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP for real OTP delivery (optional for local demo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Demo account overrides for local testing only
DEMO_EXPORTER_EMAIL=
DEMO_EXPORTER_PASSWORD=
DEMO_IMPORTER_EMAIL=
DEMO_IMPORTER_PASSWORD=

# Stripe test mode (normal customer checkout)
PAYMENT_SIMULATION_ALLOW_TEST_OUTCOME=false
INVOICE_CATALOG_FILE=invoices.json
PAYMENT_LEDGER_FILE=payment_ledger.json

# Development local payment flow (no real payment network). Set PAYMENT_PROVIDER_MODE=stripe only when client Stripe test keys are available.

# Presentation mode: 0 = never show the login code / demo hints on the page (code goes to email, or the server console without SMTP)
SHOW_DEV_HINTS=1
