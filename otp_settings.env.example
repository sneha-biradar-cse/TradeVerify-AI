# ===== TradeVerify: where the 6-digit login code is sent (email, SMS, WhatsApp) =====
# Fill in only what you want to use, save, and restart. No quotes needed.
# KEEP THIS FILE PRIVATE: it holds passwords / tokens. Never share it, upload it, or paste it in a chat.
#
# Test a channel BEFORE starting the server:
#   python check_otp_delivery.py email    you@gmail.com
#   python check_otp_delivery.py sms      +919876543210
#   python check_otp_delivery.py whatsapp +919876543210

# ---------- Which channels to use ----------
# The code goes to every channel listed that is configured below AND that the user gave at sign-up.
# Options: email, sms, whatsapp.   Example: OTP_CHANNELS=email,sms
OTP_CHANNELS=email,sms

# ---------- 1. EMAIL (works with Gmail App Password, Office 365, SendGrid SMTP, Amazon SES SMTP ...) ----------
# Gmail: 2-Step Verification ON, then Google Account > Security > App passwords (16 characters, NOT your normal password).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_FROM=

# ---------- 2. SMS (and 3. WhatsApp) through Twilio: https://www.twilio.com ----------
# Twilio console shows the Account SID and Auth Token. A free trial account can message ONLY phone numbers you have
# verified in the console. For India, sending SMS to real customers also needs TRAI DLT registration of your sender
# and message template; ask Twilio (or your SMS provider) how to do that for your account.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use EITHER a Twilio phone number OR a Messaging Service:
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp: the Twilio WhatsApp sandbox number is whatsapp:+14155238886 (each tester must join the sandbox first).
# WHATSAPP_FROM=whatsapp:+14155238886

# Mobile numbers typed WITHOUT a country code are assumed to be in this country:
DEFAULT_PHONE_COUNTRY_CODE=+91

# ---------- Safety limits (protect your bill from SMS-pumping abuse) ----------
# OTP_MAX_SMS_PER_NUMBER_PER_HOUR=5
# OTP_MAX_EMAIL_PER_ADDRESS_PER_HOUR=10
